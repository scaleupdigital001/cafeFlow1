# CafeFlow Frontend Environment Variables
# Copy this file to .env.local for local development

# Base URL of the backend API (without trailing slash)
# Production: https://cafeflow1-xndm.onrender.com
# Local: http://localhost:5000
NEXT_PUBLIC_API_URL=https://cafeflow1-xndm.onrender.com

# Socket.IO Server URL (without trailing slash)
# Production: https://cafeflow1-xndm.onrender.com
# Local: http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=https://cafeflow1-xndm.onrender.com
